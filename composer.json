{
  "name": "gilbertnigg/kirby-vite-tailwind",
  "description": "Kirby 6 boilerplate with Vite",
  "type": "project",
  "keywords": [
    "kirby",
    "kirby6",
    "vite"
  ],
  "license": "MIT",
  "authors": [
    {
      "name": "Gilbert Nigg",
      "homepage": "https://www.gilles.ch"
    }
  ],
  "homepage": "https://getkirby.com",
  "support": {
    "forum": "https://forum.getkirby.com",
    "source": "https://github.com/getkirby/composerkit"
  },
  "require": {
    "php": "~8.3.0 || ~8.4.0 || ~8.5.0",
    "getkirby/cms": "6.0.0-alpha.3",
    "arnoson/kirby-vite": "^5.7"
  },
  "config": {
    "allow-plugins": {
      "getkirby/composer-installer": true
    },
    "optimize-autoloader": true
  },
  "extra": {
    "kirby-cms-path": false
  },
  "scripts": {
    "start": [
      "Composer\\Config::disableProcessTimeout",
      "@php -S localhost:8000 -t public vendor/getkirby/cms/router.php"
    ]
  }
}
