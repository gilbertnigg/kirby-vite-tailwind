# System files
# ------------

Icon
.DS_Store

# Temporary files
# ---------------

/public/media/*
!/public/media/.gitkeep

# Lock files
# ---------------

.lock

# Editors
# (sensitive workspace files)
# ---------------------------

*.sublime-workspace
/.vscode
/.idea

# Composer dependencies
# ---------------------

/vendor

# Composer-installed Kirby plugins
# --------------------------------

/site/plugins/kirby-vite

# Frontend dependencies and builds
# --------------------------------

/node_modules
/public/assets/build/

# Vite development files
# ----------------------

/.dev
/site/config/vite.config.php

# -------------SECURITY-------------
# NEVER publish these files via Git!
# -------------SECURITY-------------

# Accounts
# ---------------

/data/storage/accounts/*
!/data/storage/accounts/.gitkeep

# Content
# ---------------

/data/storage/content/

# Runtime Files
# ---------------

/data/runtime/*
!/data/runtime/cache/.gitkeep
!/data/runtime/logs/.gitkeep
!/data/runtime/sessions/.gitkeep

# License
# ---------------

/data/storage/.license

# Environment configuration
# ---------------

/site/config/env.php
/.env
/.env.*
!/.env.example
